{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "jsx-a11y"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    // Stylistic. The remaining roles are deliberate ARIA patterns: live regions (role="status"),
    // a roving-focus radio group built from buttons, labelled SVG images and a focus-trapped modal.
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "ignorePatterns": ["dist", "node_modules"]
}
