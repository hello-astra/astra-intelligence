# Copy to .env.local and fill in what you need. Every variable is optional:
# anything left empty falls back to a clearly labelled demo behavior.
# Vite inlines VITE_* values into the public JavaScript bundle at build time,
# so NEVER put secrets (LLM / OCR provider API keys) here — use a backend.

# Contact form: POST endpoint that receives enquiries as JSON.
# Empty → enquiries are kept in the visitor's browser and the form offers an email fallback.
VITE_CONTACT_ENDPOINT=

# "Book a Consultation": external scheduling page (Cal.com, Calendly, …).
# Empty → the button opens the contact form with "consultation" pre-selected.
VITE_BOOKING_URL=

# AI chatbot demo: your backend proxy that calls an LLM. Empty → built-in rule-based engine.
VITE_CHAT_API_URL=

# OCR demo: your backend endpoint that runs OCR on an uploaded file. Empty → sample documents
# use predefined results and uploads go to manual entry.
VITE_OCR_API_URL=
