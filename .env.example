# Copy to .env.local and fill in what you need. Every variable is optional:
# anything left empty falls back to a clearly labelled demo behavior.
# Vite inlines VITE_* values into the public JavaScript bundle at build time,
# so NEVER put secrets (LLM / OCR provider API keys) here — use a backend.

# Contact form email (server-side only — these are NOT prefixed with VITE_ and never reach
# the browser). The form posts to /api/contact, which sends the enquiry through Gmail.
#   1. Turn on 2-Step Verification for the Gmail account.
#   2. Create an app password at https://myaccount.google.com/apppasswords
#   3. Paste the 16-character password below (locally), and add the same two variables in
#      Vercel → Project → Settings → Environment Variables (production).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: deliver enquiries to a different inbox than GMAIL_USER.
CONTACT_TO=

# Optional: send enquiries to another JSON endpoint instead of the built-in /api/contact.
VITE_CONTACT_ENDPOINT=

# "Book a Consultation": external scheduling page (Cal.com, Calendly, …).
# Empty → the button opens the contact form with "consultation" pre-selected.
VITE_BOOKING_URL=

# AI chatbot demo: your backend proxy that calls an LLM. Empty → built-in rule-based engine.
VITE_CHAT_API_URL=

# OCR demo: your backend endpoint that runs OCR on an uploaded file. Empty → sample documents
# use predefined results and uploads go to manual entry.
VITE_OCR_API_URL=
